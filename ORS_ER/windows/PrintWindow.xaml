<Window x:Class="ORS_ER.windows.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ORS_ER.windows"
        Title="Print" Width="300" Height="150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="center">
            <Label Content="Select variable to print:" VerticalAlignment="Center"/>
            <TextBox x:Name="VariableComboBox" Width="100" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="center">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="Button_Click"/>
            <Button Content="Cancel" Width="80" Click="Button_Click_1" />
        </StackPanel>
    </Grid>
</Window>
