<Window x:Class="ORS_ER.windows.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ORS_ER.windows"
        mc:Ignorable="d"
        Title="Input" Width="320" Height="140"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Name:" Width="40" VerticalAlignment="Center"/>
            <TextBox x:Name="NameTextBox" Width="200" />
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Value:" Width="40" VerticalAlignment="Center"/>
            <TextBox x:Name="ValueTextBox" Width="200"  />
        </WrapPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Reset" Width="80" Margin="0,0,8,0" Click="Clear_Click"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
