<Window x:Class="ORS_ER.windows.LabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Label" Height="140" Width="320" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox Name="LabelTextBox" Height="28" VerticalAlignment="Top" />
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="OkButton" Width="80" Margin="4" Click="Ok_Click">OK</Button>
            <Button Name="CancelButton" Width="80" Margin="4" Click="Cancel_Click">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
