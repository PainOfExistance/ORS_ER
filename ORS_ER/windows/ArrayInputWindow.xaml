<Window x:Class="ORS_ER.windows.ArrayInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Array Input" Width="520" Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Name:" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="NameTextBox" Width="400"/>
        </WrapPanel>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Element type:" Width="90" VerticalAlignment="Center"/>
            <ComboBox x:Name="ArrayTypeComboBox" Width="400"/>
        </WrapPanel>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Input mode:" Width="90" VerticalAlignment="Center"/>
            <RadioButton x:Name="ArrayElementsRadio" Content="Elements" Margin="0,0,12,0" Checked="ArrayMode_Checked"/>
            <RadioButton x:Name="ArrayLengthRadio" Content="Length" Checked="ArrayMode_Checked"/>
        </WrapPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,8" x:Name="ArrayElementsPanel">
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="Element:" Width="90" VerticalAlignment="Center"/>
                <TextBox x:Name="ArrayElementInputTextBox" Width="280"/>
                <Button Content="Add" Width="80" Margin="10,0,0,0" Click="AddElement_Click"/>
            </WrapPanel>
            <ListBox x:Name="ArrayItemsListBox" Height="90"/>
            <WrapPanel Margin="0,6,0,0">
                <Button Content="Remove Selected" Width="160" Click="RemoveSelected_Click"/>
                <Button Content="Clear" Width="80" Margin="10,0,0,0" Click="ClearElements_Click"/>
            </WrapPanel>
        </StackPanel>

        <WrapPanel Grid.Row="4" Margin="0,0,0,8" x:Name="ArrayLengthPanel" Visibility="Collapsed">
            <TextBlock Text="Length:" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="ArrayLengthTextBox" Width="400"/>
        </WrapPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
            <Button Content="Clear and close" Width="120" Margin="8,0,0,0" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
