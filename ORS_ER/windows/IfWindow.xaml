<Window x:Class="ORS_ER.windows.IfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ORS_ER.windows"
        mc:Ignorable="d"
        Title="If" Height="150" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Variable 1:" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="0" x:Name="Variable1" Width="80" Margin="5" IsEditable="True" SelectionChanged="VariableInput_SelectionChanged" KeyUp="VariableInput_KeyUp" LostFocus="VariableInput_LostFocus"/>

        <Label Grid.Row="0" Grid.Column="1" Content="Operation:" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LogicTypeComboBox" Width="80" Margin="5"/>

        <Label Grid.Row="0" Grid.Column="2" Content="Varaible 2:" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="2" x:Name="Variable2" Width="80" Margin="5" IsEditable="True" SelectionChanged="VariableInput_SelectionChanged" KeyUp="VariableInput_KeyUp" LostFocus="VariableInput_LostFocus"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="5" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
