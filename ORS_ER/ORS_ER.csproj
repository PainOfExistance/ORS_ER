	<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
	<PackageReference Include="Microsoft.CodeAnalysis.Scripting" Version="4.14.0" />
  </ItemGroup>

</Project>
