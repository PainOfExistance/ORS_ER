<Window x:Class="ORS_ER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ORS_ER"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Grid ShowGridLines="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <ToolBarPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <ToolBar>
                <Button x:Name="New" Content="New" Click="New_Click"/>
                <Button x:Name="Save" Content="Save as diagram" Click="Save_Click"/>
                <Button x:Name="Load" Content="Load"/>
                <Button x:Name="Help" Content="Help"/>
                <Separator/>
                <Button x:Name="Run" Content="Run" Click="Run_Click"/>
            </ToolBar>
        </ToolBarPanel>

        <StackPanel Grid.Row="1" Grid.Column="0">
            <ListView x:Name="LayersListView"
                      ItemsSource="{Binding Items}"
                      Height="400"
                      Margin="5">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding Description}"/>
                            <TextBlock Text="{Binding Category}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <skia:SKElement x:Name="skiaElement"
                        Grid.Row="1" Grid.Column="1"
                        PaintSurface="OnPaintSurface"
                        MouseDown="SkiaElement_OnMouseDown"
                        MouseMove="SkiaElement_OnMouseMove"
                        MouseUp="SkiaElement_OnMouseUp"
                        MouseWheel="SkiaElement_OnMouseWheel"/>

        <TextBox x:Name="ConsoleOutput" Grid.Row="1" Grid.Column="2"
                 Text="Output panel:"
                 Margin="5"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 />
    </Grid>
</Window>