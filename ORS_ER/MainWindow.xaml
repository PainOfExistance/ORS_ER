<Window x:Class="ORS_ER.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ORS_ER"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="800" MinWidth="1220"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Separator/>
                <Menu>
                    <MenuItem Header="File">
                        <MenuItem x:Name="New" Header="New" Click="New_Click"/>
                        <MenuItem x:Name="Save" Header="Save" Click="Save_Click" IsEnabled="False"/>
                        <MenuItem x:Name="SaveAs" Header="Save As" Click="SaveAs_Click"/>
                        <MenuItem x:Name="Load" Header="Load" Click="Load_Click"/>
                        <Separator/>
                        <MenuItem x:Name="SaveComponent" Header="Save component" Click="SaveComponent_Click"/>
                        <MenuItem x:Name="LoadComponent" Header="Load component" Click="LoadComponent_Click"/>
                        <Separator/>
                        <MenuItem x:Name="ExportPng" Header="Export PNG" Click="ExportPng_Click"/>
                    </MenuItem>
                </Menu>
                <Button x:Name="Run" Content="Run" Click="Run_Click"/>
                <Button x:Name="Help" Content="Help" Click="Help_Click"/>
                <Separator/>
                <Label x:Name="StatusLabel" Content="No file loaded"/>
                <Separator/>
                <TextBlock VerticalAlignment="Center" Text="Simulation:" Margin="4,0,6,0"/>
                <ComboBox x:Name="SimulationPicker"
                          Width="160"
                          SelectedIndex="0"
                          SelectionChanged="SimulationPicker_SelectionChanged">
                    <ComboBoxItem Content="Flowchart"/>
                    <ComboBoxItem Content="Logic Gates"/>
                </ComboBox>
            </ToolBar>
        </ToolBarTray>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="SimulationHost" Grid.Column="0"/>
        </Grid>
    </Grid>
</Window>